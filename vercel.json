{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/html/index.html" },
    { "source": "/index.html", "destination": "/html/index.html" },
    { "source": "/html/css/:match*", "destination": "/css/:match*" },
    { "source": "/html/js/:match*", "destination": "/js/:match*" },
    { "source": "/html/assets/:match*", "destination": "/assets/:match*" },
    { "source": "/explore.html", "destination": "/html/explore.html" },
    { "source": "/explore", "destination": "/html/explore.html" },
    { "source": "/trek-details.html", "destination": "/html/trek-details.html" },
    { "source": "/trek-details", "destination": "/html/trek-details.html" },
    { "source": "/login.html", "destination": "/html/login.html" },
    { "source": "/login", "destination": "/html/login.html" },
    { "source": "/signup.html", "destination": "/html/signup.html" },
    { "source": "/signup", "destination": "/html/signup.html" },
    { "source": "/dashboard.html", "destination": "/html/dashboard.html" },
    { "source": "/dashboard", "destination": "/html/dashboard.html" },
    { "source": "/my-treks.html", "destination": "/html/my-treks.html" },
    { "source": "/my-treks", "destination": "/html/my-treks.html" },
    { "source": "/manage-trek.html", "destination": "/html/manage-trek.html" },
    { "source": "/manage-trek", "destination": "/html/manage-trek.html" },
    { "source": "/favorites.html", "destination": "/html/favorites.html" },
    { "source": "/favorites", "destination": "/html/favorites.html" },
    { "source": "/profile.html", "destination": "/html/profile.html" },
    { "source": "/profile", "destination": "/html/profile.html" }
  ]
}
